# Database
DATABASE_URL=postgres://hostfunc:hostfunc@127.0.0.1:5433/hostfunc-db

# Better Auth
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Canonical public site origin — used as the metadataBase for social share
# (Open Graph / Twitter) tags. Optional; defaults to https://hostfunc.io.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social providers (required in production)
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Email (dev can leave RESEND_API_KEY empty; magic links print to terminal)
RESEND_API_KEY=
# Svix signing secret for the Resend Inbound webhook (custom-domain email triggers)
RESEND_INBOUND_WEBHOOK_SECRET=
EMAIL_FROM=no-reply@hostfunc.local

# Runtime / secrets
SECRETS_MASTER_KEY=replace-with-openssl-rand-base64-32
EXEC_TOKEN_SECRET=replace-with-openssl-rand-base64-32
RUNTIME_LOOKUP_TOKEN=replace-with-runtime-lookup-token
RUNTIME_INVOKE_TOKEN=dev-runtime-invoke-token
RUNTIME_INGEST_TOKEN=dev-ingest-token
TRIGGER_CONTROL_TOKEN=dev-trigger-token

# Infra
REDIS_URL=redis://127.0.0.1:6379
HOSTFUNC_RUNTIME_URL=http://localhost:8787
HOSTFUNC_USE_WFP=false
HOSTFUNC_EXECUTOR=auto
# Inbound trigger-address domain. Staging: staging-mail.hostfunc.io; production: hostfunc.io.
HOSTFUNC_MAIL_DOMAIN=mail.hostfunc.dev

# Cloudflare (optional unless using Cloudflare executor)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_DISPATCH_NAMESPACE=hostfunc-dev
CF_FN_INDEX_KV_ID=
CF_EGRESS_COUNTERS_KV_ID=
# Optional: small static assets (index.html, css, js) embed into the worker
# bundle automatically. A KV namespace is only needed for assets too large to
# embed (see PER_ASSET_EMBED_CAP / TOTAL_EMBED_BUDGET in executor-cloudflare).
CF_FN_ASSETS_KV_ID=

# Cloudflare for SaaS — custom domains (optional; feature gated on CF_SAAS_ZONE_ID).
# Dedicated SaaS zone (e.g. hostfunc.app). CF_API_TOKEN must also carry SSL &
# Certificates: Edit + Custom Hostnames + Zone: Read on this zone.
CF_SAAS_ZONE_ID=
CF_SAAS_CNAME_TARGET=cname.hostfunc.app
CF_SAAS_FALLBACK_ORIGIN=
# KV namespace mapping custom hostname -> {orgSlug, fnSlug}, read by the runtime worker.
CF_DOMAIN_INDEX_KV_ID=

# Billing (optional until billing enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App telemetry / security allow-lists
ALLOWED_ORIGINS=http://localhost:3000
MCP_ALLOWED_ORIGINS=http://localhost:3000
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=
SENTRY_DSN=
ALERT_WEBHOOK_URL=

# Supabase (workspace logo storage — optional)
# Create a PUBLIC storage bucket and point SUPABASE_LOGO_BUCKET at it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LOGO_BUCKET=workspace-logos
