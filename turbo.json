{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_BETTER_AUTH_URL",
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GITHUB_INTEGRATIONS_CLIENT_ID",
    "GITHUB_INTEGRATIONS_CLIENT_SECRET",
    "GITHUB_INTEGRATIONS_REDIRECT_URI",
    "GITHUB_OAUTH_SCOPES",
    "GITHUB_OAUTH_REDIRECT_URI",
    "EMAIL_FROM",
    "RESEND_API_KEY",
    "REDIS_URL",
    "SECRETS_MASTER_KEY",
    "EXEC_TOKEN_SECRET",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "CF_ACCOUNT_ID",
    "CF_API_TOKEN",
    "CF_DISPATCH_NAMESPACE",
    "CF_FN_INDEX_KV_ID",
    "CF_EGRESS_COUNTERS_KV_ID",
    "CF_FN_ASSETS_KV_ID",
    "HOSTFUNC_USE_WFP",
    "HOSTFUNC_RUNTIME_URL",
    "RUNTIME_LOOKUP_TOKEN",
    "RUNTIME_INVOKE_TOKEN",
    "RUNTIME_INGEST_TOKEN",
    "TRIGGER_CONTROL_TOKEN",
    "HOSTFUNC_MAIL_DOMAIN",
    "HOSTFUNC_EXECUTOR",
    "MCP_ALLOWED_ORIGINS",
    "ALLOWED_ORIGINS",
    "POSTHOG_API_KEY",
    "POSTHOG_HOST",
    "POSTHOG_PROJECT_ID",
    "SENTRY_DSN",
    "ALERT_WEBHOOK_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["*.tsbuildinfo"]
    },
    "clean": {
      "cache": false
    }
  }
}
